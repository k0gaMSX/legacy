420 '*       hoofd loop            *
430 '*******************************
440 '
450 U=USR0(0)
460 C=C+1
470 FOR N=1 TO 3
480   IF C=S(N) THEN I(N)=1
490   IF I(N)=0 THEN 540
500   X=V(N,Z(N)): Y=V(N,Z(N)+1): Z(N)=Z(N)+2
5¦ÞºÌ}t10   ON N GOSUB 1520,1550,1580
520   IF Y=150 AND X<>H+16 THEN GOTO 1610
530   IF Z(N)=97 THEN Z(N)=1: GOSUB 2050
540   B=STICK(0) OR STICK(1)
550   IF (B<>3 AND B<>7) THEN 580
560   IF (B=3 AND H<140) THEN H=H+80: GOSUB 2190
570   IF B=7 AND H>16 TH¦ÞºÌ}tEN H=H-80: GOSUB 2190
580 NEXT N
590 GOTO 460
